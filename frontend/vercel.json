{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/AakArtesanias/browser/es",
  "installCommand": "npm install",
  "devCommand": "ng serve",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aakonline-production.up.railway.app/api/:path*"
    },
    {
      "source": "/shop",
      "destination": "/shop/index.html"
    },
    {
      "source": "/shipping",
      "destination": "/shipping/index.html"
    },
    {
      "source": "/category/:slug",
      "destination": "/category/:slug/index.html"
    },
    {
      "source": "/product/:slug",
      "destination": "/product/:slug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff2?|ttf|svg|png|jpg|jpeg|gif|webp|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
